{
  "name": "@eclipse-glsp-examples/workflow-glsp",
  "version": "2.7.0",
  "description": "GLSP diagrams for the Workflow DSL",
  "keywords": [
    "glsp",
    "workflow",
    "diagram",
    "example"
  ],
  "homepage": "https://www.eclipse.org/glsp/",
  "bugs": "https://github.com/eclipse-glsp/glsp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-glsp/glsp-client.git"
  },
  "license": "(EPL-2.0 OR GPL-2.0 WITH Classpath-exception-2.0)",
  "author": {
    "name": "Eclipse GLSP"
  },
  "contributors": [
    {
      "name": "Eclipse GLSP Project",
      "email": "glsp-dev@eclipse.org",
      "url": "https://projects.eclipse.org/projects/ecd.glsp"
    }
  ],
  "type": "module",
  "main": "lib/index",
  "types": "lib/index",
  "files": [
    "lib",
    "src",
    "css"
  ],
  "scripts": {
    "build": "yarn build:langium && yarn build:worker && tsc -b",
    "build:langium": "langium generate --file ./src/langium/config/langium-config.json",
    "build:worker": "webpack --config webpack.config.worker.cjs",
    "bundle": "yarn build:langium && yarn build:worker",
    "clean": "rimraf tsconfig.tsbuildinfo lib",
    "lint": "eslint ./src",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "~20.1.1",
    "@codingame/monaco-vscode-editor-api": "~20.1.1",
    "@codingame/monaco-vscode-keybindings-service-override": "~20.1.1",
    "@codingame/monaco-vscode-lifecycle-service-override": "~20.1.1",
    "@codingame/monaco-vscode-localization-service-override": "~20.1.1",
    "@codingame/monaco-vscode-textmate-service-override": "~20.1.1",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "~20.1.1",
    "@codingame/monaco-vscode-theme-service-override": "~20.1.1",
    "@eclipse-glsp/client": "2.7.0",
    "@typefox/monaco-editor-react": "~6.11.0",
    "balloon-css": "^0.5.0",
    "glsp-langium-integration": "^0.1.3",
    "langium": "^4.0.0",
    "monaco-editor-wrapper": "~6.11.0",
    "monaco-languageclient": "~9.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-languageclient": "~9.0.1",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "langium-cli": "^4.0.0",
    "ts-loader": "^9.5.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
