{
  "name": "admission-action-node",
  "scopeName": "source.admission-action-node",
  "fileTypes": [
    ".admission_action_node"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.admission-action-node",
      "match": "\\b(Admit to|Amber Bay|Red Bay|Side Room)\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.admission-action-node",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.admission-action-node"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.admission-action-node"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.admission-action-node"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.admission-action-node"
        }
      ]
    }
  }
}
