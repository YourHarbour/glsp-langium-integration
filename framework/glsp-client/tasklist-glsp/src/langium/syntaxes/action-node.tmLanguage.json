{
  "name": "action-node",
  "scopeName": "source.action-node",
  "fileTypes": [
    ".action_node"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.action-node",
      "match": "\\b(Check|Perform)\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.action-node",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.action-node"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.action-node"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.action-node"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.action-node"
        }
      ]
    }
  }
}
