{
  "extends": "@eclipse-glsp/ts-config/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "jsx": "react",
    "reactNamespace": "JSX",
    "skipLibCheck": true,
    "composite": true,
    // "types": ["react", "react-dom"] 
    // 修改以下模块配置
    "module": "NodeNext",               // 关键修改：适配 Node.js 的 ESM 解析逻辑
    "moduleResolution": "NodeNext",     // 关键修改：使用 Node.js 的模块解析策略
    
    // 新增以下配置
    "esModuleInterop": true,            // 允许 ESM 和 CJS 互操作
    "allowSyntheticDefaultImports": true, // 允许默认导入语法
    "target": "ES2022",                  // 推荐使用最新标准
    "resolveJsonModule": true,
    "lib": ["WebWorker", "ESNext", "DOM"],
  },
  "include": ["src", "src/**/*.json", "types.d.ts"]
}