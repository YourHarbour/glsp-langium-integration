 healthcareDiagram.util,
 org.eclipse.glsp.example.healthcareDiagram,
 org.eclipse.glsp.example.healthcareDiagram.impl,
 org.eclipse.glsp.example.healthcareDiagram.util
Require-Bundle: org.eclipse.core.runtime,
